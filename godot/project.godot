; RED STATIC — first-person 3D.
;
; A presentation port of the 2D game, not a redesign. The simulation numbers
; come from data/*.json, exported from the same registries the 2D build runs
; on (tools/godot/export-data.mjs), so weapons, archetypes, wave timing and
; the five-minute extract objective are the originals.

config_version=5

[application]
config/name="RED STATIC"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/show_image=false

[autoload]
GameData="*res://scripts/game_data.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
; Expand rather than letterbox. The default keeps the 16:9 design aspect and
; pads the rest, which on a 19.5:9 phone put black bars down both sides and
; shrank the play area by about a fifth.
window/stretch/aspect="expand"

[input]
move_forward={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":87}]}
move_back={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":83}]}
move_left={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":65}]}
move_right={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":68}]}
dash={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":32}]}
ability={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":81}]}
fire={"deadzone":0.2,"events":[{"resource_local_to_scene":false,"type":"InputEventMouseButton","button_index":1},{"resource_local_to_scene":false,"type":"InputEventKey","physical_keycode":4194325}]}

[input_devices]

; Touch is handled as touch. With emulation on, every tap also arrives as a
; mouse click, which on the web tries to take a pointer lock that a phone has
; no pointer for, and the stick would fight its own synthetic cursor.
pointing/emulate_mouse_from_touch=false

[display]

; A first-person shooter with two thumb controls at the bottom corners is a
; landscape game. Portrait puts both thumbs in the same place and leaves the
; sightline a letterbox.
window/handheld/orientation=4

[rendering]
; The Web platform refuses to export unless ETC2/ASTC compression is imported,
; because WebGL2 carries no guarantee of S3TC. Enabling it re-imports every
; texture in a second format, which costs build time and package size but is
; not optional for a browser build.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
; Browsers have no Vulkan, so the web build runs the Compatibility backend
; over WebGL2. Desktop keeps Forward+. Godot picks the override by platform
; feature tag, so one project serves both without a branch in the scripts.
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=16
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
; Compatibility has no screen space antialiasing and no way to fake it, so
; asking for FXAA there is an error per frame. Multisampling drops to 2x and
; the shadow map halves on the web as well: a browser build is running on
; whatever GPU the page happens to land on, including a phone's.
anti_aliasing/quality/screen_space_aa.web=0
anti_aliasing/quality/msaa_3d.web=1
lights_and_shadows/directional_shadow/size.web=2048

; The rest of this block is the browser build paying for the fact that it is
; running on a phone. None of it touches the desktop path, which is what the
; reference captures are scored on.
;
; Render 3D at three quarters across, which is a little over half the pixels,
; and let the bilinear upscale carry it. The stretch mode above already caps
; the viewport at 1080 tall, but "expand" widens it to the device aspect, so a
; 19.5:9 phone was asking for about 2.5 megapixels of deferred-lit,
; glow-post-processed frame per refresh. At 0.75 that is 1.4, and on a screen
; held at arm's length the difference is not the thing anyone notices -- the
; frame rate is.
rendering/scaling_3d/scale.web=0.75
; Hard shadow edges instead of the 6x6 filter. Quality 3 is the most expensive
; of the five settings and it is sampling a 2048 atlas here, so it is buying
; softness the phone cannot afford.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
; 16x anisotropy on every surface in a triplanar scene is three texture
; lookups per sample times sixteen taps. 4x keeps the ground from turning to
; mush at grazing angles, which is all it was there for.
textures/default_filters/anisotropic_filtering_level.web=2
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.85, 1)
